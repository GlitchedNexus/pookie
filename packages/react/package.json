{
  "name": "@glitchednexus/pookie",
  "version": "0.1.0",
  "description": "Accessible, typed React components",
  "keywords": [
    "react",
    "components",
    "component-library",
    "typescript",
    "ui"
  ],
  "homepage": "https://github.com/GlitchedNexus/pookie#readme",
  "bugs": {
    "url": "https://github.com/GlitchedNexus/pookie/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GlitchedNexus/pookie.git",
    "directory": "packages/react"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/index.css",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup && tailwindcss -i ./src/styles.css -o ./dist/index.css --minify",
    "check:package": "publint && attw --pack --entrypoints .",
    "dev": "concurrently --kill-others-on-fail --names js,css \"tsup --watch\" \"tailwindcss -i ./src/styles.css -o ./dist/index.css --watch\"",
    "lint": "eslint src",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.3.0 <20"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@tailwindcss/cli": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "concurrently": "catalog:",
    "jsdom": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
